# cTrader Open API credentials
# Obtain from: https://openapi.ctrader.com/apps
CTRADER_CLIENT_ID=your_client_id
CTRADER_CLIENT_SECRET=your_client_secret

# OAuth2 access token (refresh monthly)
# Obtain via: https://id.ctrader.com/my/settings/openapi/grantingaccess/
CTRADER_ACCESS_TOKEN=your_access_token

# cTrader account ID (numeric, shown in the cTrader platform)
CTRADER_ACCOUNT_ID=your_account_id

# live or demo
CTRADER_ENV=live
